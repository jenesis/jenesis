#!/usr/bin/env bash
set -e
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
    LINK="$(readlink "$SCRIPT")"
    case "$LINK" in
        /*) SCRIPT="$LINK" ;;
        *) SCRIPT="$(dirname "$SCRIPT")/$LINK" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd -P)"
JENESIS_HOME="$(dirname "$SCRIPT_DIR")"

# Every Jenesis up to and including this version is refused: its engine is no longer
# considered safe to run, so a project that records one is sent to jenesis-unsafe rather
# than built. Raise it here and in jenesis.bat together, in the release that supersedes
# the version it names.
UNSAFE_THROUGH="0.14.0"

DIR="$PWD"
VENDORED=""
while :; do
    if [ -d "$DIR/build/jenesis" ]; then
        VENDORED="$DIR/build/jenesis"
        break
    fi
    [ "$DIR" = "/" ] && break
    DIR="$(dirname "$DIR")"
done

version() {
    local jar
    for jar in "$1"/sources/*-sources.jar; do
        if [ -f "$jar" ]; then
            jar="$(basename "$jar" .jar)"
            jar="${jar#build.jenesis-}"
            printf '%s' "${jar%-sources}"
            return 0
        fi
    done
    return 1
}

STAMP=""
if [ -n "$VENDORED" ] && [ -f "$VENDORED/jenesis.version" ]; then
    STAMP="$(cat "$VENDORED/jenesis.version")"
fi
if [ -z "$STAMP" ]; then
    STAMP="$(version "$JENESIS_HOME")" || STAMP=""
fi

# A version is read as its leading numeric components, so that a pre-release of a version
# counts as that version: 0.14.0-rc1 is refused where 0.14.0 is, and a version that names
# no number at all reads as 0.0.0 and is refused as well.
above() {
    local left="${1%%[!0-9.]*}" right="$2" l r
    while [ -n "$left" ] || [ -n "$right" ]; do
        l="${left%%.*}"
        r="${right%%.*}"
        [ -n "$l" ] || l=0
        [ -n "$r" ] || r=0
        if [ "$l" -gt "$r" ]; then return 0; fi
        if [ "$l" -lt "$r" ]; then return 1; fi
        case "$left" in *.*) left="${left#*.}" ;; *) left="" ;; esac
        case "$right" in *.*) right="${right#*.}" ;; *) right="" ;; esac
    done
    return 1
}

if [ -n "$STAMP" ] && ! above "$STAMP" "$UNSAFE_THROUGH"; then
    echo "jenesis: ${VENDORED:-$JENESIS_HOME} is at version ${STAMP}, and every Jenesis up to ${UNSAFE_THROUGH} is no longer considered safe" >&2
    cat >&2 <<EOM
jenesis: refusing to run - this launcher executes a Jenesis newer than ${UNSAFE_THROUGH} only, so
    that a project cannot pull an engine whose release is no longer trusted.

Move the project on, which is the fix this asks for: re-vendor build/jenesis from the
installed version and commit what changes.

    jenesis-init                 re-vendor build/jenesis from the installed version
    jenesis-validate             report how the vendored tree differs from it first

Where ${STAMP} has to run all the same - reproducing an old build, a branch that is not
moving - the unguarded launcher still runs it, and still verifies the vendored sources
against the published ones before it does:

    jenesis-unsafe [selectors]   run the ${STAMP} the project records

Warning: that command runs an engine that is no longer considered safe.
EOM
    exit 1
fi

if [ ! -x "$SCRIPT_DIR/jenesis-unsafe" ]; then
    echo "jenesis: ${SCRIPT_DIR} ships no executable jenesis-unsafe to hand the build over to" >&2
    exit 1
fi
exec "$SCRIPT_DIR/jenesis-unsafe" "$@"
