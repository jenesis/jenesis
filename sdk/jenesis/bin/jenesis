#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
JENESIS_HOME="$(dirname "$SCRIPT_DIR")"

DIR="$PWD"
VENDORED=""
while :; do
    if [ -d "$DIR/build/jenesis" ]; then
        ROOT="$DIR"
        VENDORED="$DIR/build/jenesis"
        break
    fi
    [ "$DIR" = "/" ] && break
    DIR="$(dirname "$DIR")"
done

if [ -z "$VENDORED" ]; then
    exec "$SCRIPT_DIR/jenesis-make" "$@"
fi

refuse() {
    echo "jenesis: $1" >&2
    cat >&2 <<EOM
jenesis: refusing to run - this launcher only executes a released Jenesis whose published
    sources match ${VENDORED} exactly, so that no unreviewed build code ever runs under it.

The released engine still builds this project as a standard build, which is often all a
project needs. Neither of these executes the vendored build code:

    . jenesis-switch            switch this shell to the version the project records
    jenesis-make [selectors]     run the installed engine as it stands

Only where the project truly needs its own engine, run the vendored sources yourself, from
the project root at ${ROOT}. Read the project's build instructions first: Make.java is
the usual entry point, but a project that vendors a changed engine states why it does, and
may drive it from one of its own.

    java build/jenesis/Make.java [selectors]

Source mode recompiles the engine on every invocation. To pay that once instead:

    javac build/jenesis/Make.java
    java build.jenesis.Project [selectors]

Warning: those commands execute unreviewed code with the rights of your build and can
break the encapsulation the released engine gives you. Only run builds from sources you
trust.
EOM
    exit 1
}

version() {
    local jar
    for jar in "$1"/sources/*-sources.jar; do
        if [ -f "$jar" ]; then
            jar="$(basename "$jar" .jar)"
            jar="${jar#build.jenesis-}"
            printf '%s' "${jar%-sources}"
            return 0
        fi
    done
    return 1
}

STAMP=""
if [ -f "$VENDORED/jenesis.version" ]; then
    STAMP="$(cat "$VENDORED/jenesis.version")"
fi
if [ -z "$STAMP" ]; then
    STAMP="$(version "$JENESIS_HOME")" || STAMP=""
fi
if [ -z "$STAMP" ]; then
    refuse "${VENDORED} records no version in jenesis.version and ${JENESIS_HOME} ships no sources to assume one from"
fi

locate() {
    local home
    if [ "$(version "$JENESIS_HOME" 2>/dev/null || true)" = "$1" ]; then
        printf '%s' "$JENESIS_HOME"
        return 0
    fi
    for home in \
            "${SDKMAN_DIR:-$HOME/.sdkman}/candidates/jenesis/$1" \
            "$(dirname "$JENESIS_HOME")/$1" \
            "$HOME/scoop/apps/jenesis/$1"; do
        if [ -d "$home/bin" ]; then
            printf '%s' "$home"
            return 0
        fi
    done
    if command -v brew >/dev/null 2>&1; then
        home="$(brew --cellar jenesis 2>/dev/null)/$1"
        if [ -d "$home/bin" ]; then
            printf '%s' "$home"
            return 0
        fi
        if [ -d "$home/libexec/bin" ]; then
            printf '%s' "$home/libexec"
            return 0
        fi
    fi
    return 1
}

sdkman() {
    command -v sdk >/dev/null 2>&1 && return 0
    [ -s "${SDKMAN_DIR:-$HOME/.sdkman}/bin/sdkman-init.sh" ]
}

digestOf() {
    (cd "$1" && find . -name '*.java' | LC_ALL=C sort | xargs "$HASH" | "$HASH" | cut -d' ' -f1)
}

if command -v sha256sum >/dev/null 2>&1; then
    HASH=sha256sum
elif command -v shasum >/dev/null 2>&1; then
    HASH="shasum -a 256"
else
    refuse "no SHA-256 tool found - install 'sha256sum' or 'shasum', without one ${VENDORED} cannot be verified"
fi

TARGET_HOME="$(locate "$STAMP")" || TARGET_HOME=""
if [ -z "$TARGET_HOME" ] && sdkman; then
    echo "jenesis: build/jenesis records ${STAMP}, installing that version via SDKMAN" >&2
    (
        set +e
        if ! command -v sdk >/dev/null 2>&1; then
            # shellcheck disable=SC1090
            . "${SDKMAN_DIR:-$HOME/.sdkman}/bin/sdkman-init.sh" >/dev/null 2>&1
        fi
        command -v sdk >/dev/null 2>&1 || exit 1
        printf 'n\n' | sdk install jenesis "$STAMP" >&2
    ) || true
    TARGET_HOME="$(locate "$STAMP")" || TARGET_HOME=""
fi
if [ -z "$TARGET_HOME" ]; then
    refuse "no installed Jenesis matches the ${STAMP} that ${VENDORED} records, and it could not be installed - install it with 'sdk install jenesis ${STAMP}' or from https://jenesis.build"
fi

REFERENCE=""
for jar in "$TARGET_HOME"/sources/*-sources.jar; do
    if [ -f "$jar" ]; then
        REFERENCE="$jar"
        break
    fi
done
if [ -z "$REFERENCE" ]; then
    refuse "Jenesis ${STAMP} at ${TARGET_HOME} ships no sources jar, so ${VENDORED} cannot be verified against it"
fi

EXTRACTED="$(mktemp -d)"
trap 'rm -rf "$EXTRACTED"' EXIT
if command -v unzip >/dev/null 2>&1; then
    unzip -qq -o "$REFERENCE" 'build/jenesis/*' -d "$EXTRACTED" >/dev/null 2>&1 || true
elif command -v jar >/dev/null 2>&1; then
    (cd "$EXTRACTED" && jar xf "$REFERENCE" build/jenesis) >/dev/null 2>&1 || true
fi
if [ ! -d "$EXTRACTED/build/jenesis" ]; then
    refuse "the sources of Jenesis ${STAMP} in ${REFERENCE} could not be read, so ${VENDORED} cannot be verified against them"
fi

if [ "$(digestOf "$VENDORED")" != "$(digestOf "$EXTRACTED/build/jenesis")" ]; then
    refuse "${VENDORED} does not match the sources of Jenesis ${STAMP}"
fi

rm -rf "$EXTRACTED"
trap - EXIT

if [ ! -x "$TARGET_HOME/bin/jenesis-make" ]; then
    refuse "Jenesis ${STAMP} at ${TARGET_HOME} ships no executable bin/jenesis-make to dispatch to"
fi
exec "$TARGET_HOME/bin/jenesis-make" "$@"
