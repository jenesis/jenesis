#!/usr/bin/env bash
set -eu
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
    LINK="$(readlink "$SCRIPT")"
    case "$LINK" in
        /*) SCRIPT="$LINK" ;;
        *) SCRIPT="$(dirname "$SCRIPT")/$LINK" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd -P)"
JENESIS_HOME="$(dirname "$SCRIPT_DIR")"

usage() {
    cat <<'EOM'
Usage: jenesis-jdk [--tool=sdkman|mise] <version>

Installs a JDK for a Jenesis toolchain version, as 25, 25.0.3 or 25-temurin, with
the tool that installed Jenesis, SDKMAN or mise, into the folder that tool keeps its
JDKs in, which Jenesis searches by default. Where one of them installed Jenesis, the
jenesis command names jenesis-jdk in JENESIS_TOOLCHAIN_INSTALLER for the run it
starts, and that run calls it back when no installed JDK matches
jenesis.toolchain.version.

  --tool=<tool>  install with sdkman or mise rather than the tool that installed
                 Jenesis
  --help         print this help

A word of the version names the vendor: temurin, zulu, corretto, liberica,
microsoft, sapmachine, semeru, graalvm, oracle or jetbrains, and Temurin without
one. The newest build matching every number is installed, except that mise names
Zulu builds by Zulu's own version, so it installs the newest Zulu of the feature
release. With SDKMAN, ea installs an early-access build from jdk.java.net. Jenesis
checks whatever was installed against the version before it runs it.
EOM
}

fail() {
    echo "jenesis-jdk: $1" >&2
    exit "${2:-1}"
}

TOOL=""
VERSION=""
for ARGUMENT in "$@"; do
    case "$ARGUMENT" in
        --help)
            usage
            exit 0
            ;;
        --tool=sdkman | --tool=mise) TOOL="${ARGUMENT#--tool=}" ;;
        -*)
            usage >&2
            exit 64
            ;;
        *)
            if [ -n "$VERSION" ]; then
                usage >&2
                exit 64
            fi
            VERSION="$ARGUMENT"
            ;;
    esac
done

if [ -z "$VERSION" ]; then
    usage >&2
    exit 64
fi
PATTERN='^([1-9][0-9]*(\.(0|[1-9][0-9]*))*)((-[A-Za-z]+)*)$'
[[ "$VERSION" =~ $PATTERN ]] || fail "malformed version '$VERSION' (expected <feature>[.<interim>[.<update>...]][-<word>...], as 25, 25.0.3 or 25-temurin)" 64
NUMBERS="${BASH_REMATCH[1]}"
WORDS="${BASH_REMATCH[4]}"
FEATURE="${NUMBERS%%.*}"

VENDOR=""
EA=""
JVMCI=""
vendor() {
    if [ -n "$VENDOR" ] && [ "$VENDOR" != "$1" ]; then
        fail "$VERSION names two vendors, $VENDOR and $1" 2
    fi
    VENDOR="$1"
}
for WORD in $(printf '%s' "$WORDS" | tr '[:upper:]-' '[:lower:] '); do
    case "$WORD" in
        temurin | adoptium | eclipse) vendor temurin ;;
        zulu | azul) vendor zulu ;;
        corretto | amazon) vendor corretto ;;
        liberica | bellsoft) vendor liberica ;;
        microsoft) vendor microsoft ;;
        sapmachine | sap) vendor sapmachine ;;
        semeru | ibm) vendor semeru ;;
        graalvm | community) vendor graalvm ;;
        oracle) vendor oracle ;;
        jetbrains) vendor jetbrains ;;
        jvmci) JVMCI=1 ;;
        ea) EA=1 ;;
        lts | ca | inc | corporation | systems | com | se | b) ;;
        *) fail "no vendor jenesis-jdk knows answers to '$WORD' in $VERSION" 2 ;;
    esac
done
if [ -n "$JVMCI" ]; then
    case "$VENDOR" in
        oracle) VENDOR=oracle-graalvm ;;
        "" | graalvm) VENDOR=graalvm ;;
        *) fail "$VERSION names $VENDOR, which builds no JDK with jvmci" 2 ;;
    esac
fi
if [ -n "$EA" ]; then
    case "$VENDOR" in
        "" | oracle) VENDOR=openjdk-ea ;;
        *) fail "$VERSION asks for an early-access build of $VENDOR, and jenesis-jdk installs early-access builds of OpenJDK only" 2 ;;
    esac
fi
VENDOR="${VENDOR:-temurin}"

SDKMAN_HOME="${SDKMAN_DIR:-$HOME/.sdkman}"
MISE_HOME="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
for CANDIDATE in "sdkman $SDKMAN_HOME/candidates" "mise $MISE_HOME"; do
    [ -z "$TOOL" ] || break
    ROOT="$(cd "${CANDIDATE#* }" 2>/dev/null && pwd -P)" || continue
    case "$JENESIS_HOME/" in
        "$ROOT/"*) TOOL="${CANDIDATE%% *}" ;;
    esac
done
[ -n "$TOOL" ] || fail "neither SDKMAN nor mise installed the Jenesis at $JENESIS_HOME, and jenesis-jdk installs a JDK with the tool that installed Jenesis - name one with --tool=sdkman or --tool=mise, or install the JDK yourself"

if [ "$TOOL" = sdkman ]; then
    [ -s "$SDKMAN_HOME/bin/sdkman-init.sh" ] || fail "SDKMAN is not installed at $SDKMAN_HOME"
    case "$VENDOR" in
        temurin) DIST=tem ;;
        zulu) DIST=zulu ;;
        corretto) DIST=amzn ;;
        liberica) DIST=librca ;;
        microsoft) DIST=ms ;;
        sapmachine) DIST=sapmchn ;;
        semeru) DIST=sem ;;
        graalvm) DIST=graalce ;;
        oracle-graalvm) DIST=graal ;;
        oracle) DIST=oracle ;;
        jetbrains) DIST=jbr ;;
        openjdk-ea) DIST=open ;;
    esac
    sdkman() {
        (
            set +eu
            # shellcheck disable=SC1091
            . "$SDKMAN_HOME/bin/sdkman-init.sh" > /dev/null 2>&1
            sdk "$@"
        )
    }
    LISTING="$(sdkman list java 2>&1)" || fail "SDKMAN could not list the Java versions it offers: $LISTING"
    IDENTIFIER="$(printf '%s\n' "$LISTING" | awk -F'|' -v dist="$DIST" -v numbers="$NUMBERS" -v ea="$EA" '
        NF >= 4 {
            id = $NF
            gsub(/[[:space:]]/, "", id)
            suffix = "-" dist
            if (length(id) <= length(suffix) || substr(id, length(id) - length(suffix) + 1) != suffix) {
                next
            }
            version = substr(id, 1, length(id) - length(suffix))
            if (ea != "") {
                if (version !~ /^[0-9]+(\.[0-9]+)*(\.ea\.|\+ea\.)[0-9]+$/) {
                    next
                }
            } else if (version !~ /^[0-9]+(\.[0-9]+)*(\+[0-9]+(\.[0-9]+)*)?$/) {
                next
            }
            match(version, /^[0-9]+(\.[0-9]+)*/)
            wanted = split(numbers, want, ".")
            offered = split(substr(version, 1, RLENGTH), have, ".")
            for (i = 1; i <= wanted; i++) {
                if ((i <= offered ? have[i] + 0 : 0) != want[i] + 0) {
                    next
                }
            }
            key = ""
            rest = version
            for (count = 0; count < 8; count++) {
                if (match(rest, /[0-9]+/)) {
                    key = key sprintf("%09d", substr(rest, RSTART, RLENGTH) + 0)
                    rest = substr(rest, RSTART + RLENGTH)
                } else {
                    key = key sprintf("%09d", 0)
                }
            }
            print key "\t" id
        }' | sort | tail -n 1 | cut -f 2)"
    [ -n "$IDENTIFIER" ] || fail "SDKMAN offers no Java build for $VERSION among its identifiers ending in -$DIST"
    if [ "$SDKMAN_HOME" != "$HOME/.sdkman" ]; then
        echo "jenesis-jdk: SDKMAN keeps its JDKs in $SDKMAN_HOME/candidates/java, which Jenesis searches only when jenesis.toolchain.searchpath names it" >&2
    fi
    echo "jenesis-jdk: installing $IDENTIFIER with SDKMAN for $VERSION"
    printf 'n\n' | sdkman install java "$IDENTIFIER" || fail "SDKMAN failed to install $IDENTIFIER"
    [ -d "$SDKMAN_HOME/candidates/java/$IDENTIFIER" ] || fail "SDKMAN reported no failure but did not install $IDENTIFIER into $SDKMAN_HOME/candidates/java"
else
    command -v mise > /dev/null 2>&1 || fail "mise is not on the PATH"
    case "$VENDOR" in
        openjdk-ea) fail "jenesis-jdk installs early-access builds with SDKMAN only - use --tool=sdkman" 2 ;;
        graalvm) NAME=graalvm-community ;;
        semeru) NAME=semeru-openj9 ;;
        *) NAME="$VENDOR" ;;
    esac
    REQUEST="$NUMBERS"
    if [ "$VENDOR" = zulu ] && [ "$NUMBERS" != "$FEATURE" ]; then
        echo "jenesis-jdk: mise names Zulu builds by Zulu's own version, so it installs the newest Zulu $FEATURE, which Jenesis then checks against $VERSION" >&2
        REQUEST="$FEATURE"
    fi
    if [ "$MISE_HOME" != "$HOME/.local/share/mise" ]; then
        echo "jenesis-jdk: mise keeps its JDKs in $MISE_HOME/installs/java, which Jenesis searches only when jenesis.toolchain.searchpath names it" >&2
    fi
    echo "jenesis-jdk: installing java@$NAME-$REQUEST with mise for $VERSION"
    mise install "java@$NAME-$REQUEST" || fail "mise failed to install java@$NAME-$REQUEST"
fi
