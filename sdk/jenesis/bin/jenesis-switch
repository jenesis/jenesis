#!/usr/bin/env bash
#
# jenesis-switch: discover the Jenesis version recorded in
# build/jenesis/jenesis.version of each target, install it if needed, and
# switch the current shell to it. SDKMAN, Scoop and Homebrew installations are
# all found. Must be sourced so that the switch affects the calling shell:
#
#     . jenesis-switch [targets...]
#     source jenesis-switch [targets...]
#
# With no arguments, the current directory is the target. With one or more
# arguments, every target must agree on the recorded version, otherwise
# the switch is aborted.

if (return 0 2>/dev/null); then
    _JS_SOURCED=1
else
    _JS_SOURCED=0
fi

_jenesis_switch_locate() {
    local home
    for home in \
            "${SDKMAN_DIR:-$HOME/.sdkman}/candidates/jenesis/$1" \
            "$HOME/scoop/apps/jenesis/$1"; do
        if [ -d "$home/bin" ]; then
            printf '%s' "$home"
            return 0
        fi
    done
    if command -v brew >/dev/null 2>&1; then
        home="$(brew --cellar jenesis 2>/dev/null)/$1"
        if [ -d "$home/bin" ]; then
            printf '%s' "$home"
            return 0
        fi
        if [ -d "$home/libexec/bin" ]; then
            printf '%s' "$home/libexec"
            return 0
        fi
    fi
    return 1
}

# Homebrew is absent here: a formula carries the one version it was published
# at, so it can hold a match but cannot fetch the version a project records.
_jenesis_switch_install() {
    if ! command -v sdk >/dev/null 2>&1; then
        local sdkman_init="${SDKMAN_DIR:-$HOME/.sdkman}/bin/sdkman-init.sh"
        if [ -s "$sdkman_init" ]; then
            # shellcheck disable=SC1090
            . "$sdkman_init"
        fi
    fi
    if command -v sdk >/dev/null 2>&1; then
        echo "jenesis-switch: installing Jenesis $1 via SDKMAN"
        # Answer "n" to SDKMAN's "set as default? (Y/n)" prompt: switching is a
        # shell-local action, the user can run 'sdk default jenesis X' separately.
        printf 'n\n' | sdk install jenesis "$1" && return 0
    fi
    if command -v scoop >/dev/null 2>&1; then
        echo "jenesis-switch: installing Jenesis $1 via Scoop"
        scoop install "jenesis@$1" && return 0
    fi
    return 1
}

_jenesis_switch_path() {
    local rest="$PATH" out="" entry
    while [ -n "$rest" ]; do
        entry="${rest%%:*}"
        if [ "$rest" = "$entry" ]; then
            rest=""
        else
            rest="${rest#*:}"
        fi
        [ "$entry" = "$1" ] && continue
        [ -n "${_JENESIS_SWITCH_BIN:-}" ] && [ "$entry" = "$_JENESIS_SWITCH_BIN" ] && continue
        out="${out:+$out:}$entry"
    done
    PATH="$1${out:+:$out}"
    export PATH
    _JENESIS_SWITCH_BIN="$1"
}

_jenesis_switch_main() {
    local labeled=0
    if [ "$#" -gt 0 ]; then
        labeled=1
    else
        set -- "."
    fi

    local discovered_version=""
    local discovered_from=""
    local target abs_target version_file cur_version prefix target_clean

    for target in "$@"; do
        target_clean="${target%/}"
        if [ "$labeled" = "1" ]; then
            prefix="${target_clean} - "
        else
            prefix=""
        fi
        if [ ! -d "$target" ]; then
            echo "jenesis-switch: target '$target' is not a directory" >&2
            return 1
        fi
        abs_target="$(cd "$target" && pwd -P)"
        version_file="$abs_target/build/jenesis/jenesis.version"
        if [ ! -d "$abs_target/build/jenesis" ]; then
            echo "jenesis-switch: ${prefix}no build/jenesis found" >&2
            return 1
        fi
        if [ ! -f "$version_file" ]; then
            echo "jenesis-switch: ${prefix}no version found" >&2
            return 1
        fi
        cur_version="$(cat "$version_file")"
        if [ -z "$cur_version" ]; then
            echo "jenesis-switch: ${prefix}jenesis.version is empty" >&2
            return 1
        fi
        if [ -z "$discovered_version" ]; then
            discovered_version="$cur_version"
            discovered_from="$target_clean"
        elif [ "$discovered_version" != "$cur_version" ]; then
            echo "jenesis-switch: version conflict - ${discovered_from} is at ${discovered_version}, ${target_clean} is at ${cur_version}" >&2
            return 1
        fi
    done

    echo "jenesis-switch: discovered version ${discovered_version}"

    local home
    home="$(_jenesis_switch_locate "${discovered_version}")" || home=""
    if [ -z "$home" ]; then
        _jenesis_switch_install "${discovered_version}" || true
        home="$(_jenesis_switch_locate "${discovered_version}")" || home=""
    fi
    if [ -z "$home" ]; then
        echo "jenesis-switch: Jenesis ${discovered_version} is not installed and could not be installed - install it with 'sdk install jenesis ${discovered_version}', 'scoop install jenesis@${discovered_version}' or from https://jenesis.build" >&2
        return 1
    fi

    if [ "$home" = "${SDKMAN_DIR:-$HOME/.sdkman}/candidates/jenesis/${discovered_version}" ] \
            && command -v sdk >/dev/null 2>&1; then
        if ! sdk use jenesis "${discovered_version}"; then
            echo "jenesis-switch: 'sdk use jenesis ${discovered_version}' failed" >&2
            return 1
        fi
    else
        _jenesis_switch_path "${home}/bin"
        echo "jenesis-switch: ${home}/bin leads PATH in this shell"
    fi
    echo "jenesis-switch: switched to Jenesis ${discovered_version}"
    return 0
}

if [ "$_JS_SOURCED" = "0" ]; then
    cat >&2 <<'EOM'
jenesis-switch: this script must be sourced so that the switch takes effect
in the current shell. Run it as:

    . jenesis-switch [targets...]
    source jenesis-switch [targets...]
EOM
    exit 1
fi

_jenesis_switch_main "$@"
_jenesis_switch_rc=$?
unset -f _jenesis_switch_main _jenesis_switch_locate _jenesis_switch_install _jenesis_switch_path
unset _JS_SOURCED
return $_jenesis_switch_rc
